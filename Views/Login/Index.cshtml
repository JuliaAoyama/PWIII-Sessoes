@model Login
@{
    Layout = "_LayoutDeslogado";
    ViewData["Title"] = "Login";
}

<main class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow border-0 p-5 w-100" style="max-width: 500px;">

        <div class="text-center mb-4">
            <h1 class="h2 fw-bold mb-2">Minha tela de login</h1>
            <p class="text-muted fs-5 mb-0">Insira as informações para entrar no sistema</p>
        </div>

        <form method="post" asp-controller="Login" asp-action="Entrar">
            <div class="mb-3">
                <label asp-for="Nome" class="form-label fs-5">Nome:</label>
                <input type="text" asp-for="Nome" class="form-control form-control-lg" placeholder="Seu nome" />
                @Html.ValidationMessageFor(x => x.Nome)
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fs-5">Email:</label>
                <input type="email" asp-for="Email" class="form-control form-control-lg" placeholder="seu@email.com" />
                @Html.ValidationMessageFor(x => x.Email)
            </div>

            <div class="mb-4">
                <label asp-for="Senha" class="form-label fs-5">Senha:</label>
                <input type="password" asp-for="Senha" class="form-control form-control-lg" placeholder="••••••••" />
                @Html.ValidationMessageFor(x => x.Senha)
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 py-3">Entrar</button>
            
            <div class=mb-4>
                <p>@ViewBag.MensagemLogin</p>
            </div>
        </form>

    </div>
</main>